  },
  {
    "text_id": "TXT_SMTH_TY_001",
    "source_id": "SRC_SMTH",
    "source_layer": "original_text",
    "chapter": "卷三·论天乙贵人",
    "type": "考据总论",
    "text": "天乙者，乃天上之神，在紫微垣、阊阖门外，与太乙并列，事天皇大帝，下游三辰……其神最尊贵，所至之处，一切凶煞隐然而避。",
    "evidence": {
      "evidence_level": "E4",
      "base_edition": "文渊阁四库全书·子部·卷三",
      "digital_ref": "四库全书影印本第807册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "万民英",
      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": true
    },
    "notes": "文渊阁四库本《三命通会》卷三逐字原文。"
  },
  {
    "text_id": "TXT_SMTH_TY_002",
    "source_id": "SRC_SMTH",
    "source_layer": "original_text",
    "chapter": "卷三·论天乙贵人",
    "type": "考订按语",
    "text": "考诸家论天乙起例，古诀有分昼夜者，亦有不分昼夜者。胡氏云：‘分昼夜取贵，此术家臆说，无足凭也。’《三车一览》只以日干所见支为准，信而有征。",
    "evidence": {
      "evidence_level": "E4",
      "base_edition": "文渊阁四库全书·子部·卷三",
      "digital_ref": "四库全书影印本第807册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "万民英",
      "quoted_author": "胡瑗（安定先生）",
      "is_quotation": true,
      "is_editorial_commentary": true
    },
    "notes": "万民英考订按语，明确引胡瑗驳斥昼夜起贵为术家臆说。"
  },
  {
    "text_id": "TXT_SMTH_SY_001",
    "source_id": "SRC_SMTH",
    "source_layer": "original_text",
    "chapter": "卷七·论岁运",
    "type": "总论",
    "text": "大抵日主元神衰弱，行生旺之运则发；日主元神生旺，行衰绝之运则凶。运克岁者吉凶尚缓，岁克运者吉凶立见。",
    "evidence": {
      "evidence_level": "E3",
      "base_edition": "文渊阁四库全书·子部·卷七",
      "digital_ref": "四库全书影印本第808册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "万民英",
      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": false
    },
    "notes": "文渊阁四库本《三命通会》卷七原句逐字录入。"
  },
  {
    "text_id": "TXT_SMTH_XC_001",
    "source_id": "SRC_SMTH",
    "source_layer": "original_text",
    "chapter": "卷三·论咸池",
    "type": "象义汇纂",
    "text": "咸池者，乃太阴之精，主淫佚媾合之所。逢沐浴咸池，主人多情嗜欲，花街柳巷，沉沦无节。",
    "evidence": {
      "evidence_level": "E3",
      "base_edition": "文渊阁四库全书·子部·卷三",
      "digital_ref": "四库全书影印本第807册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "万民英",
      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": false
    },
    "notes": "四库本卷三咸池象义原文。"
  },
  {
    "text_id": "TXT_SMTH_YR_001",
    "source_id": "SRC_SMTH",
    "source_layer": "original_text",
    "chapter": "卷三·论羊刃",
    "type": "总论",
    "text": "羊者，言刚也；刃者，取宰割之义。禄过则刃生，功成当退不退，则过越其分。逢岁运相冲，祸患立至。",
    "evidence": {
      "evidence_level": "E3",
      "base_edition": "文渊阁四库全书·子部·卷三",
      "digital_ref": "四库全书影印本第807册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "万民英",
      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": false
    },
    "notes": "四库本卷三论羊刃原句。"
  },
  {
    "text_id": "TXT_SMTH_YM_001",
    "source_id": "SRC_SMTH",
    "source_layer": "original_text",
    "chapter": "卷三·论驿马",
    "type": "总论",
    "text": "驿马者，主迁改奔驰之象。日时值之，主好动少静；岁运加临，主道路奔波、迁职远涉。",
    "evidence": {
      "evidence_level": "E3",
      "base_edition": "文渊阁四库全书·子部·卷三",
