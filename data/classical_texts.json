  },
  {
    "text_id": "TXT_DTS_SW_001",
    "source_id": "SRC_DTS",
    "source_layer": "original_jingtou",
    "chapter": "衰旺",
    "type": "经文",
    "text": "能知衰旺之真机，其于立命之奥，思过半矣。旺则宜泄宜伤，衰则喜帮喜助，子平之理也。然旺中有衰者存，不可损也；衰中有旺者存，不可益也。旺之极者不可损，以损在其中矣；衰之极者不可益，以益在其中矣。",
    "evidence": {
      "evidence_level": "E4",
      "base_edition": "守山阁丛书本·卷上 / 道光二十八年晋阳刻本",
      "digital_ref": "ctext:ditiansui/17",
      "transcription_verified": true,
      "variants": [
        {
          "edition": "部分通行坊本",
          "has_variant": true,
          "variant_text": "其于三命之奥（坊本作三命，守山阁与道光原刻作立命）"
        }
      ]
    },
    "text_provenance": {
      "author": "京图",
      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": false
    },
    "notes": "道光刻本与守山阁本均为‘立命’而非‘三命’，底本无后人私加之‘宜从宜顺’等词。"
  },
  {
    "text_id": "TXT_DTS_SY_001",
    "source_id": "SRC_DTS",
    "source_layer": "original_jingtou",
    "chapter": "岁运",
    "type": "经文",
    "text": "休咎系乎运，尤系乎岁。战冲绁掣，往往为祸；休祥顺逆，亦当详审。",
    "evidence": {
      "evidence_level": "E3",
      "base_edition": "守山阁丛书本·卷下",
      "digital_ref": "ctext:ditiansui/岁运",
