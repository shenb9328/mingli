  {
    "text_id": "TXT_YHZP_BF_001",
    "source_id": "SRC_YHZP",
    "source_layer": "original_text",
    "chapter": "宝法第一",
    "type": "论法",
    "text": "子平一法，专以日干为主，而取提纲所藏之物为令；次及年月时支以表其端。凡格用月令提纲，勿于傍求年日时为格；今人多不知其法，于此百法百失。",
    "evidence": {
      "evidence_level": "E2",
      "verification_status": "externally_verified",
      "digital_refs": [
        "https://book.taiyi.me/命/子平推命/渊海子平(赋论)"
      ],
      "transcription_verified": true,
      "scan_verified": false,
      "variants": []
    },
    "text_provenance": {
      "traditional_attribution": "《渊海子平·宝法》",
      "attribution_status": "traditional_text_attribution",
      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": false
    }
  },
  {
    "text_id": "TXT_YHZP_BF_002",
    "source_id": "SRC_YHZP",
    "source_layer": "original_text",
    "chapter": "宝法第二",
    "type": "论法",
    "text": "子平之法，以日为主；先看提纲为重，次用年日时支，合成格局，方可断之；皆以月令为用，不可以年取格。凡看子平之数，取格不定，十有九差。",
