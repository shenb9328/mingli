      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": false
    },
    "notes": "京图原文，确立岁运干支战冲掣肘为吉凶发越机锋。"
  },
  {
    "text_id": "TXT_YHZP_ML_001",
    "source_id": "SRC_YHZP",
    "source_layer": "bian_zhe",
    "chapter": "卷一·论月令",
    "type": "原文",
    "text": "月令者，如人之家宅。专以月令提纲为重，次看日干得何等气，若月令有官星，即为官禄之命。",
    "evidence": {
      "evidence_level": "E3",
      "base_edition": "文渊阁四库全书·子部·卷一",
      "digital_ref": "ctext:yuanhai-ziping/juan-1",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "徐升",
      "quoted_author": null,
      "is_quotation": false,
      "is_editorial_commentary": false
    },
    "notes": "四库本文渊阁影印本卷一原文。"
  },
  {
    "text_id": "TXT_YHZP_JS_001",
    "source_id": "SRC_YHZP",
    "source_layer": "fu_wen",
    "chapter": "卷三·继善篇",
    "type": "赋文",
    "text": "欲知贵贱，先观月令乃提纲；次察中和，要审日主为紧要。",
    "evidence": {
      "evidence_level": "E4",
      "base_edition": "文渊阁四库全书·子部·卷三·继善篇第一句",
      "digital_ref": "四库全书影印本第809册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "先贤（宋代托名璐国公）",
      "quoted_author": null,
      "is_quotation": true,
      "is_editorial_commentary": false
    },
    "notes": "子平古赋首句，定月令提纲与日主中和之体用纲目。"
  },
  {
    "text_id": "TXT_YHZP_JS_002",
    "source_id": "SRC_YHZP",
    "source_layer": "fu_wen",
    "chapter": "卷三·继善篇",
    "type": "赋文",
    "text": "岁运并临，灾殃立至。阳刃偏官，伪为慈祥之德。",
    "evidence": {
      "evidence_level": "E4",
      "base_edition": "文渊阁四库全书·子部·卷三·继善篇",
      "digital_ref": "四库全书影印本第809册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "先贤古赋",
      "quoted_author": null,
      "is_quotation": true,
      "is_editorial_commentary": false
    },
    "notes": "古赋原句逐字录入，后世注疏多辨其吉凶仍系于用神。"
  },
  {
    "text_id": "TXT_YHZP_JS_003",
    "source_id": "SRC_YHZP",
    "source_layer": "fu_wen",
    "chapter": "卷三·继善篇",
    "type": "赋文",
    "text": "天乙贵人，得聪明智慧之资；福星贵人，受平生福寿之享。",
    "evidence": {
      "evidence_level": "E4",
      "base_edition": "文渊阁四库全书·子部·卷三·继善篇",
      "digital_ref": "四库全书影印本第809册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
      "author": "先贤古赋",
      "quoted_author": null,
      "is_quotation": true,
      "is_editorial_commentary": false
    },
    "notes": "四库本《渊海子平》卷三继善篇原句。"
  },
  {
    "text_id": "TXT_YHZP_XJ_001",
    "source_id": "SRC_YHZP",
    "source_layer": "fu_wen",
    "chapter": "卷三·喜忌篇",
    "type": "赋文",
    "text": "庚辛得局，相生见火，定作廊庙之材。",
    "evidence": {
      "evidence_level": "E4",
      "base_edition": "文渊阁四库全书·子部·卷三·喜忌篇",
      "digital_ref": "四库全书影印本第809册",
      "transcription_verified": true,
      "variants": []
    },
    "text_provenance": {
