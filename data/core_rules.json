    "rule_type": "核心",
    "name": "体用辨证不可一端论",
    "priority": 100,
    "source_refs": ["DTX_001"],
    "text_refs": ["DTX_001_001"],
    "statement": {
      "principle": "体用因局而化：或以日主为体、提纲为用；或以提纲为体、喜神为用；或以四柱为体、岁运为用。不可执定日主一人为体。",
      "deduction": "判定原局用神与岁运得失前，必须先确立当前的体用结构模型，严禁机械死扣日主强弱套用单一生克。",
      "strength": "决定性"
    },
    "conditions": {
      "required": ["已完成命局干支五行与月令旺相统计"],
      "exclusions": ["不得在未审定体用模型前妄断吉凶"]
    },
    "scope": ["原局", "提纲", "大运", "流年", "动态重构"],
