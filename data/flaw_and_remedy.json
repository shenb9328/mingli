{
  "schema_version": "1.0",
  "description": "病药结构模式库。条件是工程化布尔近似，不是古籍原文；用于生成候选‘病’与‘药’，不得直接输出吉凶。",
  "logic_dsl": {
    "AND": "全部满足",
    "OR": "任一满足",
    "NOT": "不满足",
    "COUNT_GTE": "数量至少达到N",
    "HAS": "存在",
    "ABSENT": "不存在",
    "ROOTED": "有根",
    "CLASHED": "存在冲",
    "COMBINED": "存在合/会局"
  },
  "patterns": [
