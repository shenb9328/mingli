          "食神生财",
          "食带杀_AND无财",
          "弃食就杀_AND透印"
        ]
      },
      "failure": {
        "OR": [
          "枭神夺食",
          "生财露杀"
        ]
      },
      "rescue": [
        "生财护食",
        "就杀成格"
      ]
    },
    "七杀格": {
      "formation": {
        "ALL": [
          "MONTH_TEN_GOD_EQ:七杀"
        ]
      },
      "success": {
        "OR": [
          "身强七杀逢制",
          "印化杀"
        ]
      },
      "failure": {
        "OR": [
          "七杀逢财无制"
        ]
      },
      "rescue": [
        "食神制杀",
        "印化杀"
      ]
    },
    "伤官格": {
      "formation": {
        "ALL": [
          "MONTH_TEN_GOD_EQ:伤官"
        ]
      },
      "success": {
        "OR": [
          "伤官生财",
          "伤官佩印_AND伤旺",
