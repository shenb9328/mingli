{
  "schema_version": "1.0",
  "description": "《子平真诠》八格成败救应的机器可读条件树。表达式是程序化近似，不把现代布尔表达式冒充古文。",
  "patterns": {
    "正官格": {
      "formation": {
        "ALL": [
          "MONTH_TEN_GOD_EQ:正官"
        ]
      },
      "success": {
        "OR": [
          "HAS:财星_AND印星",
          "HAS:财星",
          "HAS:印星"
        ],
        "NOT": [
          "CLASHED:正官",
          "DAMAGED_BY:伤官"
        ]
      },
      "failure": {
        "OR": [
          "DAMAGED_BY:伤官",
          "CLASHED:正官",
          "HARMED_BY:刑冲"
        ]
      },
      "rescue": [
        "印制伤",
        "合杀清杂",
        "会合解冲"
      ]
    },
    "财格": {
      "formation": {
        "ALL": [
          "MONTH_TEN_GOD_EQ:正财",
          "MONTH_TEN_GOD_EQ:偏财"
        ]
      },
      "success": {
        "OR": [
          "财生官",
          "食神生财_AND身强",
          "财印位置妥贴"
        ]
      },
      "failure": {
        "OR": [
          "比劫过重",
          "财透七杀"
        ]
      },
      "rescue": [
        "食神化劫",
        "官制比劫",
        "合杀存财"
      ]
    },
    "印格": {
