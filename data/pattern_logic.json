          "伤官带杀_AND无财"
        ]
      },
      "failure": {
        "OR": [
          "伤官见官",
          "生财带杀",
          "佩印而伤轻身旺"
        ]
      },
      "rescue": [
        "佩印",
        "生财",
        "合杀"
      ]
    },
    "阳刃格": {
