        "ALL": [
          "MONTH_TEN_GOD_EQ:正印",
          "MONTH_TEN_GOD_EQ:偏印"
        ]
      },
      "success": {
        "OR": [
          "印轻逢杀",
          "官印双全",
          "身印旺_AND食伤泄",
          "印多逢财_AND财透根轻"
        ]
      },
      "failure": {
        "OR": [
          "印轻逢财",
          "身强印重_AND透杀"
        ]
      },
      "rescue": [
        "劫财解财",
        "合财存印"
      ]
    },
    "食神格": {
      "formation": {
        "ALL": [
          "MONTH_TEN_GOD_EQ:食神"
        ]
      },
